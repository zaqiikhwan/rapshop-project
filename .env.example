# --- database ---
DB_USER=
DB_PASS=
DB_HOST=
DB_NAME=

# --- auth ---
# shared secret required to register an admin
TOKEN=
# secret used to sign/verify admin JWTs
JWT_KEY=

# --- supabase storage ---
# bucket name
STORAGE_NAME=
# supabase service token
SERVICE_TOKEN=
# public base url prefix for supabase-hosted images
BASE_URL=
# supabase storage api url
SUPABASE_URL=

# --- midtrans ---
# midtrans server key (used as Basic auth, base64-encoded at runtime)
AUTHORIZATION_VALUE=
# midtrans charge endpoint, e.g. https://api.midtrans.com/v2/charge
MIDTRANS=
# optional Midtrans status base URL, default is https://api.midtrans.com/v2
MIDTRANS_STATUS_URL=
# midtrans environment: sandbox | production
MIDTRANS_ENV=sandbox

# --- server ---
# debug (default) or release
GIN_MODE=
# port to listen on, e.g. 8080
PORT=8080
# public base url of this server, used to build links to uploaded proof images
HOST_URL=
# comma-separated list of allowed CORS origins, e.g. https://dlcheap.com,http://localhost:3000
ALLOWED_ORIGINS=
# run GORM AutoMigrate unless explicitly false; set false in production
AUTO_MIGRATE=true
